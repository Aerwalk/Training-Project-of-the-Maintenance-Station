# Параметры Docker-стенда. Скопируйте файл в .env и измените значения.
POSTGRES_DB=sto
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
STO_DB_PORT=5434

# Переопределение параметров подключения приложения (имеют приоритет над application.properties)
STO_DB_URL=jdbc:postgresql://localhost:5434/sto
STO_DB_USERNAME=sto_admin
STO_DB_PASSWORD=admin_pass
STO_DB_MAX_POOL_SIZE=5
STO_DB_RETRY_MAX_ATTEMPTS=4
